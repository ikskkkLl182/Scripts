    if root then local w=root:FindFirstChild("KillerWarn"); if w then w:Destroy() end end
end

RunService.Heartbeat:Connect(function()
    local now=tick()
    if now-LastUpdateTick<0.05 then return end
    LastUpdateTick=now

    if Cfg.fullBright then
        Lighting.Ambient=Color3.fromRGB(255,255,255)
        Lighting.OutdoorAmbient=Color3.fromRGB(255,255,255)
        Lighting.Brightness=2; Lighting.ClockTime=14
        Lighting.GlobalShadows=false; Lighting.FogEnd=9e9
    end
    if now-LastFullESPRefresh>5 then LastFullESPRefresh=now; RefreshESP() end
    updateNextKillerDisplay()

    local myRoot=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local killerNearby=false
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LP then
            local t=(p.Team and p.Team.Name:lower()) or ""
            local isKiller=t:find("killer")~=nil
            local shouldESP=(isKiller and Cfg.espKillers) or (not isKiller and Cfg.espSurvivors)
            if shouldESP then updatePlayerNametag(p) else cleanupPlayerESP(p) end
            if Cfg.killerWarn and isKiller and myRoot and p.Character
                and p.Character:FindFirstChild("HumanoidRootPart") then
                if (p.Character.HumanoidRootPart.Position-myRoot.Position).Magnitude<99 then
                    killerNearby=true
                end
            end
        end
    end

    if Cfg.killerWarn and myRoot then
        local warn=myRoot:FindFirstChild("KillerWarn")
        if killerNearby then
            if not warn then
                warn=CreateBillboardTag("!",Colors.red,UDim2.new(0,50,0,50),40)
                warn.Name="KillerWarn"; warn.StudsOffset=Vector3.new(0,4,0)
                warn.Adornee=myRoot; warn.Parent=myRoot
            end
        elseif warn then warn:Destroy() end
    elseif not Cfg.killerWarn then clearKillerWarn() end

    for i=#ActiveGenerators,1,-1 do
        local g=ActiveGenerators[i]
        if g and g.Parent and Cfg.espGenerators then
            if updateGeneratorProgress(g) then table.remove(ActiveGenerators,i) end
        else table.remove(ActiveGenerators,i) end
    end
end)

