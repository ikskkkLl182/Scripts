        function() return player:FindFirstChild("PlayerGui") or player:WaitForChild("PlayerGui", 5) end,
        function() return gethui and gethui() end,
        function() return game:GetService("CoreGui") end,
    }
    for _, get in ipairs(targets) do
        local ok, parent = pcall(get)
        if ok and parent then
            local ok2 = pcall(function() gui.Parent = parent end)
            if ok2 and gui.Parent then return end
        end
    end
end
