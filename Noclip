-- =====================================================
-- HELPERS
-- =====================================================
local function nameMatches(name, list)
    local lower = string.lower(name)
    for _, kw in ipairs(list) do
        if string.find(lower, string.lower(kw), 1, true) then
            return true
        end
    end
    return false
end

-- BFS-free single-pass descendants lookup
local function findInDescendants(root, names)
    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("GuiObject") and nameMatches(obj.Name, names) then
            return obj
        end
    end
    return nil
end

local function findQteGui()
    for _, gui in ipairs(playerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui ~= screenGui and gui.Enabled then
            if nameMatches(gui.Name, GUI_KEYWORDS) then
                local p = findInDescendants(gui, POINTER_NAMES)
                if p then
                    return gui, p
                end
            end
        end
    end
    return nil, nil
end

-- AbsoluteRotation if available, else Rotation
local function getPointerAngle(pointer)
    local ok, val = pcall(function()
        return pointer.AbsoluteRotation
    end)
    if ok and type(val) == "number" then
        return val
    end
    local ok2, val2 = pcall(function()
        return pointer.Rotation
    end)
    if ok2 and type(val2) == "number" then
        return val2
    end
    return nil
end

local function normalizeAngle(a)
    a = a % 360
    if a < 0 then a = a + 360 end
    return a
end

-- Read target range from attributes or NumberValue children.
-- Returns (min, max) or (nil, nil) if not found.
local function readRangeFromZone(zone)
    local minV, maxV

    -- attributes
    local attrMin = zone:GetAttribute("TargetMin") or zone:GetAttribute("Min")
    local attrMax = zone:GetAttribute("TargetMax") or zone:GetAttribute("Max")
    if type(attrMin) == "number" and type(attrMax) == "number" then
        return attrMin, attrMax
    end

    -- NumberValue children
    for _, child in ipairs(zone:GetDescendants()) do
        if child:IsA("NumberValue") then
            local n = string.lower(child.Name)
            if not minV and string.find(n, "min", 1, true) then
                minV = child.Value
            elseif not maxV and string.find(n, "max", 1, true) then
                maxV = child.Value
            end
        end
    end

    if type(minV) == "number" and type(maxV) == "number" then
        return minV, maxV
    end

    return nil, nil
end

local function getZoneRange(zone)
    local minV, maxV = readRangeFromZone(zone)
    if minV and maxV then
        return minV, maxV
    end
    return FALLBACK_MIN, FALLBACK_MAX
end

local function pressSpace()
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
    end)
    task.delay(KEY_HOLD_TIME, function()
        pcall(function()
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        end)
    end)
end

-- =====================================================
-- TOGGLE HANDLER
-- =====================================================
button.MouseButton1Click:Connect(function()
    enabled = not enabled

    if enabled then
        button.BackgroundColor3 = Color3.fromRGB(50, 180, 90)
        btnStroke.Color         = Color3.fromRGB(20, 100, 50)
        button.Text             = "QTE:\nON"
        insideZone = false
        print("[QTE-DEBUG] Tester ENABLED")
    else
        button.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        btnStroke.Color         = Color3.fromRGB(100, 20, 20)
        button.Text             = "QTE:\nOFF"
        insideZone = false
        print("[QTE-DEBUG] Tester DISABLED")
    end
end)

-- =====================================================
-- MAIN LOOP
-- =====================================================
RunService.RenderStepped:Connect(function()
    if not enabled then return end

    -- 1. Periodic GUI scan (throttled, not every frame)
    local now = os.clock()
    if now - lastGuiScan >= GUI_SCAN_INTERVAL then
        lastGuiScan = now

        local gui, pointer = findQteGui()

        if gui then
            -- first time / changed GUI
            if gui ~= currentGui then
                currentGui     = gui
                currentPointer = pointer
                currentZone    = findInDescendants(gui, ZONE_NAMES)
                print(string.format(
                    "[QTE-DEBUG] GUI detected: %s | Pointer: %s | Zone: %s",
                    gui.Name,
                    pointer and pointer.Name or "nil",
                    currentZone and currentZone.Name or "nil"
                ))
            else
                -- re-acquire if destroyed
                if not currentPointer or not currentPointer.Parent then
                    currentPointer = pointer
                    if currentPointer then
                        print("[QTE-DEBUG] Pointer re-acquired:", currentPointer.Name)
                    end
                end
                if not currentZone or not currentZone.Parent then
                    currentZone = findInDescendants(gui, ZONE_NAMES)
                    if currentZone then
                        print("[QTE-DEBUG] Zone re-acquired:", currentZone.Name)
                    end
                end
            end
        else
            if currentGui then
                print("[QTE-DEBUG] QTE GUI lost")
                currentGui     = nil
                currentPointer = nil
                currentZone    = nil
                insideZone     = false
            end
        end
    end

    -- 2. Ready check
    if not currentPointer or not currentPointer.Parent then return end
    if not currentZone    or not currentZone.Parent    then return end

    -- 3. Angle
    local rawAngle = getPointerAngle(currentPointer)
    if not rawAngle then return end
    local angle = normalizeAngle(rawAngle)

    -- 4. Range
    local minA, maxA = getZoneRange(currentZone)

    -- Handle wrap-around range (e.g. min=350, max=10)
    local inRange
    if minA <= maxA then
        inRange = (angle >= minA and angle <= maxA)
    else
        inRange = (angle >= minA or  angle <= maxA)
    end

    -- 5. Debounced press
    if inRange then
        if not insideZone then
            insideZone = true
            pressSpace()
            print(string.format(
                "[QTE-DEBUG] HIT! angle=%.1f range=[%.1f, %.1f]",
                angle, minA, maxA
            ))
        end
    else
        insideZone = false
    end
end)

print("[QTE-DEBUG] QTE Tester loaded")
