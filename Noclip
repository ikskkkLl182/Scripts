-- Cleaned feature set: Player ESP, Generator ESP, Auto SkillCheck, Speed Boost, Menu
-- Target assumptions retained from the supplied script: Roblox, Map/Generator hierarchy,
-- Survivors team, and SkillCheckPromptGui.Check.Line/Goal UI.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local GuiService = game:GetService("GuiService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local SETTINGS = {
    PlayerESP = true,
    GeneratorESP = true,
    AutoSkillCheck = true,
    SpeedBoost = false,
    BoostSpeed = 26,
    RefreshRate = 0.20,
    GeneratorColor = Color3.fromRGB(170, 70, 255),
    KillerColor = Color3.fromRGB(255, 75, 85),
    SurvivorColor = Color3.fromRGB(65, 220, 255),
}

local running = true
local menuGui
local espGui
local skillCheckConnection
local skillVisibilityConnection
local currentHumanoid
local originalWalkSpeed
local lastRefresh = 0

local function getValue(object, name)
    if not object then return nil end
    local attribute = object:GetAttribute(name)
    if attribute ~= nil then return attribute end

    local child = object:FindFirstChild(name)
    if child then
        local ok, value = pcall(function()
            return child.Value
        end)
        if ok then return value end
    end
    return nil
end

local function getRoot(character)
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function removeNamed(parent, name)
    local object = parent and parent:FindFirstChild(name)
    if object then object:Destroy() end
end

local function applyHighlight(object, name, color)
    if not object or not object.Parent then return end

    local highlight = object:FindFirstChild(name)
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = name
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 0.78
        highlight.OutlineTransparency = 0.15
        highlight.Parent = object
    end

    highlight.Adornee = object
    highlight.FillColor = color
    highlight.OutlineColor = color
end

local function makeBillboard(parent, name, text, color)
    local billboard = parent:FindFirstChild(name)
    if not billboard then
        billboard = Instance.new("BillboardGui")
        billboard.Name = name
        billboard.AlwaysOnTop = true
        billboard.Size = UDim2.fromOffset(150, 38)
        billboard.StudsOffset = Vector3.new(0, 2.8, 0)
        billboard.Parent = parent

        local label = Instance.new("TextLabel")
        label.Name = "Label"
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.GothamBold
        label.TextSize = 12
        label.TextStrokeTransparency = 0.15
        label.TextStrokeColor3 = Color3.new(0, 0, 0)
        label.TextWrapped = true
        label.Parent = billboard
    end

    local label = billboard:FindFirstChild("Label")
    if label then
        label.Text = text
        label.TextColor3 = color
    end
end

local function updatePlayerESP(player)
    local character = player.Character
    local root = getRoot(character)

    if not SETTINGS.PlayerESP or not character or not root then
        if character then
            removeNamed(character, "KislotaPlayerHighlight")
            removeNamed(root, "KislotaPlayerTag")
        end
        return
    end

    local teamName = player.Team and player.Team.Name:lower() or ""
    local isKiller = teamName:find("killer") ~= nil
    local color = isKiller and SETTINGS.KillerColor or SETTINGS.SurvivorColor
    local displayName = player.Name

    if isKiller then
        displayName = tostring(getValue(player, "SelectedKiller") or player.Name)
    end

    local distance = 0
    local myRoot = getRoot(LocalPlayer.Character)
    if myRoot then
        distance = math.floor((root.Position - myRoot.Position).Magnitude)
    end

    makeBillboard(root, "KislotaPlayerTag",
        (isKiller and "[KILLER] " or "[SURVIVOR] ") .. displayName .. "\n" .. distance .. " studs",
        color)
    applyHighlight(character, "KislotaPlayerHighlight", color)
end

local function updateGeneratorESP(generator)
    if not generator or not generator.Parent then return end

    local tagPart = generator:FindFirstChild("defaultMaterial", true)
    if not tagPart or not tagPart:IsA("BasePart") then
        tagPart = generator:FindFirstChildWhichIsA("BasePart", true)
    end

    if not SETTINGS.GeneratorESP then
        removeNamed(generator, "KislotaGeneratorHighlight")
        removeNamed(tagPart, "KislotaGeneratorTag")
        return
    end

    applyHighlight(generator, "KislotaGeneratorHighlight", SETTINGS.GeneratorColor)

    local progress = tonumber(
        getValue(generator, "RepairProgress") or getValue(generator, "Progress")
    ) or 0

    if progress >= 100 then
        removeNamed(generator, "KislotaGeneratorHighlight")
        removeNamed(tagPart, "KislotaGeneratorTag")
        return
    end

    local rootPart = tagPart
    if not rootPart then return end

    local color = SETTINGS.GeneratorColor
    makeBillboard(rootPart, "KislotaGeneratorTag",
        string.format("GENERATOR\n%.1f%%", math.clamp(progress, 0, 100)), color)
end

local function refreshESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            updatePlayerESP(player)
        end
    end

    local map = workspace:FindFirstChild("Map")
    if map then
        for _, object in ipairs(map:GetDescendants()) do
            if object.Name == "Generator" then
                updateGeneratorESP(object)
            end
        end
    end
end

-- Auto SkillCheck
local ACTION_PATH = "Survivor-mob.Controls.action.check"
local TOUCH_ID = 8822

local function triggerSkillCheckButton()
    local target = PlayerGui
    for segment in string.gmatch(ACTION_PATH, "[^%.]+") do
        target = target and target:FindFirstChild(segment)
    end

    if not target or not target:IsA("GuiObject") then return end

    local position = target.AbsolutePosition
    local size = target.AbsoluteSize
    local inset = GuiService:GetGuiInset()
    local x = position.X + size.X / 2 + inset.X
    local y = position.Y + size.Y / 2 + inset.Y

    pcall(function()
        VirtualInputManager:SendTouchEvent(TOUCH_ID, 0, x, y)
        task.wait(0.01)
        VirtualInputManager:SendTouchEvent(TOUCH_ID, 2, x, y)
    end)
end

local function stopSkillCheck()
    if skillCheckConnection then
        skillCheckConnection:Disconnect()
        skillCheckConnection = nil
    end
end

local function bindSkillCheck()
    if skillVisibilityConnection then
        skillVisibilityConnection:Disconnect()
        skillVisibilityConnection = nil
    end
    stopSkillCheck()

    task.spawn(function()
        local prompt = PlayerGui:WaitForChild("SkillCheckPromptGui", 10)
        local check = prompt and prompt:WaitForChild("Check", 10)
        if not check then return end

        local line = check:WaitForChild("Line")
        local goal = check:WaitForChild("Goal")

        local function update()
            local isSurvivor = LocalPlayer.Team
                and LocalPlayer.Team.Name:lower():find("survivor") ~= nil

            if SETTINGS.AutoSkillCheck and isSurvivor and check.Visible then
                stopSkillCheck()
                skillCheckConnection = RunService.Heartbeat:Connect(function()
                    if not SETTINGS.AutoSkillCheck or not check.Visible then
                        stopSkillCheck()
                        return
                    end

                    local lineRotation = line.Rotation % 360
                    local goalRotation = goal.Rotation % 360
                    local startAngle = (goalRotation + 101) % 360
                    local endAngle = (goalRotation + 115) % 360

                    local inWindow
                    if startAngle > endAngle then
                        inWindow = lineRotation >= startAngle or lineRotation <= endAngle
                    else
                        inWindow = lineRotation >= startAngle and lineRotation <= endAngle
                    end

                    if inWindow then
                        triggerSkillCheckButton()
                        stopSkillCheck()
                    end
                end)
            else
                stopSkillCheck()
            end
        end

        skillVisibilityConnection = check:GetPropertyChangedSignal("Visible"):Connect(update)
        update()
    end)
end

-- Speed Boost
local function applySpeed()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    if humanoid ~= currentHumanoid then
        currentHumanoid = humanoid
        originalWalkSpeed = humanoid.WalkSpeed
    end

    if SETTINGS.SpeedBoost then
        humanoid.WalkSpeed = SETTINGS.BoostSpeed
    elseif originalWalkSpeed then
        humanoid.WalkSpeed = originalWalkSpeed
    end
end

-- Menu
local function createMenu()
    if menuGui then menuGui:Destroy() end

    menuGui = Instance.new("ScreenGui")
    menuGui.Name = "KislotaCleanMenu"
    menuGui.ResetOnSpawn = false
    menuGui.DisplayOrder = 1000
    menuGui.Parent = PlayerGui

    local frame = Instance.new("Frame")
    frame.Name = "Main"
    frame.Size = UDim2.fromOffset(230, 220)
    frame.Position = UDim2.new(0, 25, 0.35, 0)
    frame.BackgroundColor3 = Color3.fromRGB(22, 24, 31)
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = menuGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -16, 0, 32)
    title.Position = UDim2.fromOffset(8, 4)
    title.BackgroundTransparency = 1
    title.Text = "CLEAN MENU"
    title.TextColor3 = Color3.new(1, 1, 1)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 15
    title.Parent = frame

    local function addToggle(labelText, settingName, y)
        local button = Instance.new("TextButton")
        button.Size = UDim2.new(1, -20, 0, 32)
        button.Position = UDim2.fromOffset(10, y)
        button.BackgroundColor3 = Color3.fromRGB(43, 48, 60)
        button.BorderSizePixel = 0
        button.Font = Enum.Font.GothamSemibold
        button.TextSize = 12
        button.TextColor3 = Color3.new(1, 1, 1)
        button.Parent = frame

        local buttonCorner = Instance.new("UICorner")
        buttonCorner.CornerRadius = UDim.new(0, 5)
        buttonCorner.Parent = button

        local function redraw()
            button.Text = labelText .. ": " .. (SETTINGS[settingName] and "ON" or "OFF")
            button.BackgroundColor3 = SETTINGS[settingName]
                and Color3.fromRGB(35, 115, 75)
                or Color3.fromRGB(43, 48, 60)
        end

        button.MouseButton1Click:Connect(function()
            SETTINGS[settingName] = not SETTINGS[settingName]
            redraw()
            if settingName == "AutoSkillCheck" then
                bindSkillCheck()
            elseif settingName == "SpeedBoost" then
                applySpeed()
            elseif settingName == "PlayerESP" or settingName == "GeneratorESP" then
                refreshESP()
            end
        end)

        redraw()
    end

    addToggle("Player ESP", "PlayerESP", 42)
    addToggle("Generator ESP", "GeneratorESP", 80)
    addToggle("Auto SkillCheck", "AutoSkillCheck", 118)
    addToggle("Speed Boost", "SpeedBoost", 156)

    local hint = Instance.new("TextLabel")
    hint.Size = UDim2.new(1, -16, 0, 18)
    hint.Position = UDim2.fromOffset(8, 195)
    hint.BackgroundTransparency = 1
    hint.Text = "RightShift — hide/show menu"
    hint.TextColor3 = Color3.fromRGB(175, 180, 190)
    hint.Font = Enum.Font.Gotham
    hint.TextSize = 10
    hint.Parent = frame
end

local UserInputService = game:GetService("UserInputService")
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.RightShift and menuGui then
        menuGui.Enabled = not menuGui.Enabled
    end
end)

-- Startup and lifecycle
createMenu()
bindSkillCheck()
refreshESP()

LocalPlayer.CharacterAdded:Connect(function()
    currentHumanoid = nil
    originalWalkSpeed = nil
    task.wait(0.5)
    applySpeed()
    bindSkillCheck()
    refreshESP()
end)

Players.PlayerRemoving:Connect(function(player)
    if player.Character then
        removeNamed(player.Character, "KislotaPlayerHighlight")
        local root = getRoot(player.Character)
        removeNamed(root, "KislotaPlayerTag")
    end
end)

RunService.Heartbeat:Connect(function()
    if not running then return end

    applySpeed()

    local now = os.clock()
    if now - lastRefresh >= SETTINGS.RefreshRate then
        lastRefresh = now
        refreshESP()
    end
end)
