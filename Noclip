env.__AstralCleanup = function()
    S.noclip = false
    restoreNoclip()
    nowe = false
    tpwalking = false
    flyOff()

    local hum = getHum()
    if hum then
        if S.speed then hum.WalkSpeed = defaults.walk end
        if S.jump then
            hum.UseJumpPower = defaults.useJumpPower
            hum.JumpPower = defaults.jump
        end
    end
    S.speed = false
    S.jump = false

    setFullbright(false)
    workspace.Gravity = defaultGravity

    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    gui:Destroy()
    env.__AstralCleanup = nil
end
