    local team=(LP.Team and LP.Team.Name:lower()) or ""
    if not Cfg.nextKiller or not (team:find("spectator") or team:find("lobby")) then
        if label then label:Destroy() end; return
    end
    if not label then
        label=Instance.new("TextLabel",IndicatorGui)
        label.Name="NextKillerDisplay"; label.Size=UDim2.new(0,240,0,30)
        label.Position=UDim2.new(0.5,0,0,45)
        label.AnchorPoint=Vector2.new(0.5,0); label.BackgroundTransparency=0.5
        label.BackgroundColor3=Color3.new(0,0,0); label.TextColor3=Color3.new(1,1,1)
        label.Font=Enum.Font.GothamBold; label.TextSize=14; label.RichText=true
    end
    local list=Players:GetPlayers()
    table.sort(list,function(a,b)
        local aA=GetGameValue(a,"AllowKiller") or false
        local bA=GetGameValue(b,"AllowKiller") or false
        if aA~=bA then return aA end
        return (GetGameValue(a,"KillerChance") or 0)>(GetGameValue(b,"KillerChance") or 0)
    end)
    local nk=list[1]
    if nk then
        label.Text="Next Killer: <font color=\"rgb(255,93,108)\">"
            ..(nk==LP and "YOU" or tostring(GetGameValue(nk,"SelectedKiller") or nk.Name)).."</font>"
    end
end

-- ================= AUTO SKILLCHECK =================
local TouchID=8822
local ActionPath="Survivor-mob.Controls.action.check"
local HBConn,VisConn

local function GetActionTarget()
    local cur=PlayerGui
    for seg in string.gmatch(ActionPath,"[^%.]+") do cur=cur and cur:FindFirstChild(seg) end
    return cur
end
local function TriggerMobileButton()
    local b=GetActionTarget()
    if b and b:IsA("GuiObject") then
        local p,s,i=b.AbsolutePosition,b.AbsoluteSize,GuiService:GetGuiInset()
        local cx,cy=p.X+s.X/2+i.X,p.Y+s.Y/2+i.Y
        pcall(function()
            VirtualInputManager:SendTouchEvent(TouchID,0,cx,cy)
            task.wait(0.01)
            VirtualInputManager:SendTouchEvent(TouchID,2,cx,cy)
        end)
    end
end
local function InitializeAutoSkillCheck()
    task.spawn(function()
        local prompt=PlayerGui:WaitForChild("SkillCheckPromptGui",10)
        local check=prompt and prompt:WaitForChild("Check",10)
        if not check then return end
        local line,goal=check:WaitForChild("Line"),check:WaitForChild("Goal")
        if VisConn then VisConn:Disconnect() end
        VisConn=check:GetPropertyChangedSignal("Visible"):Connect(function()
            if not Cfg.autoSkillCheck then return end
            if LP.Team and LP.Team.Name=="Survivors" and check.Visible then
                if HBConn then HBConn:Disconnect() end
                HBConn=RunService.Heartbeat:Connect(function()
                    if not Cfg.autoSkillCheck then
                        if HBConn then HBConn:Disconnect(); HBConn=nil end; return
                    end
                    local lr,gr=line.Rotation%360,goal.Rotation%360
                    local ss,se=(gr+101)%360,(gr+115)%360
                    if (ss>se and (lr>=ss or lr<=se)) or (lr>=ss and lr<=se) then
                        TriggerMobileButton()
                        if HBConn then HBConn:Disconnect(); HBConn=nil end
                    end
                end)
            elseif HBConn then HBConn:Disconnect(); HBConn=nil end
        end)
    end)
end

