-- ================= ESP =================
local espList={}
local function addESP(p)
    if p==LP or not Drawing then return end
    local box=Drawing.new("Square"); box.Thickness=1; box.Filled=false
    box.Color=Color3.fromRGB(255,60,60); box.Visible=false
    local nm=Drawing.new("Text"); nm.Size=14; nm.Center=true
    nm.Outline=true; nm.Color=Color3.new(1,1,1); nm.Visible=false
    espList[p]={box=box,name=nm}
end
if Drawing then
    for _,p in ipairs(Players:GetPlayers()) do addESP(p) end
    Players.PlayerAdded:Connect(addESP)
    Players.PlayerRemoving:Connect(function(p)
        local o=espList[p]; if o then
            for _,v in pairs(o) do v:Remove() end; espList[p]=nil
        end
    end)
end

RunService.RenderStepped:Connect(function()
    if not Drawing then return end
    for p,o in pairs(espList) do
        local ch=p.Character
        local hum=ch and ch:FindFirstChildOfClass("Humanoid")
        local root=ch and ch:FindFirstChild("HumanoidRootPart")
        if CFG.esp and hum and root and hum.Health>0 then
            local sp,onS=Camera:WorldToViewportPoint(root.Position)
            if onS then
                local h=1600/sp.Z
                o.box.Size=Vector2.new(h*0.55,h)
                o.box.Position=Vector2.new(sp.X-o.box.Size.X/2, sp.Y-o.box.Size.Y/2)
                o.box.Visible=true
                o.name.Text=p.Name
                o.name.Position=Vector2.new(sp.X, sp.Y-o.box.Size.Y/2-18)
                o.name.Visible=true
            else
                o.box.Visible=false; o.name.Visible=false
            end
        else
            o.box.Visible=false; o.name.Visible=false
        end
    end
end)

-- ================= AIMBOT =================
RunService.RenderStepped:Connect(function()
    if not CFG.aimbot then return end
    local center=Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local best,bestD=nil,CFG.aimFOV
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP then continue end
        local head=p.Character and p.Character:FindFirstChild("Head")
        if not head then continue end
        local sp,onS=Camera:WorldToViewportPoint(head.Position)
        if onS then
            local d=(Vector2.new(sp.X,sp.Y)-center).Magnitude
            if d<bestD then bestD=d; best=head end
        end
    end
    if best then
        Camera.CFrame=CFrame.new(Camera.CFrame.Position,best.Position)
    end
end)

-- ================= KILL AURA =================
RunService.Heartbeat:Connect(function()
    if not CFG.killAura then return end
    local ch=LP.Character
    local root=ch and ch:FindFirstChild("HumanoidRootPart")
    local tool=ch and ch:FindFirstChildOfClass("Tool")
    if not root or not tool then return end
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP then continue end
        local tr=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if tr and (root.Position-tr.Position).Magnitude<=CFG.auraRange then
            pcall(function() tool:Activate() end)
        end
    end
end)

-- ================= SPEED / JUMP =================
RunService.Heartbeat:Connect(function()
    local hum=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if CFG.speedOn then hum.WalkSpeed=CFG.speed end
    if CFG.jumpOn  then hum.JumpPower=CFG.jump  end
end)

-- ================= AUTO SKILLCHECK =================
-- Ищет активный ScreenGui с названием skill/check/qte/minigame.
-- Тапает по движущемуся индикатору (Frame/TextLabel/ImageLabel ~ 4-40 px высотой).
local function isSkillGui(o)
    local n=o.Name:lower()
    return n:find("skill") or n:find("check") or n:find("qte") or n:find("minigame")
end

task.spawn(function()
    while true do
        task.wait(0.05)
        if not CFG.skillCheck then continue end
        local pg=LP:FindFirstChild("PlayerGui"); if not pg then continue end
        for _,sg in ipairs(pg:GetChildren()) do
            if sg:IsA("ScreenGui") and sg.Enabled and isSkillGui(sg) then
                for _,d in ipairs(sg:GetDescendants()) do
                    if (d:IsA("Frame") or d:IsA("TextLabel") or d:IsA("ImageLabel")) then
                        local sz=d.AbsoluteSize
                        if sz.Y>4 and sz.Y<40 and sz.X>4 and sz.X<80 then
                            local px=d.AbsolutePosition.X+sz.X/2
                            local py=d.AbsolutePosition.Y+sz.Y/2
                            pcall(function()
                                VIM:SendMouseButtonEvent(px,py,0,true,game,1)
                                task.wait(0.03)
                                VIM:SendMouseButtonEvent(px,py,0,false,game,1)
                            end)
                        end
                    end
                end
            end
        end
    end
end)

