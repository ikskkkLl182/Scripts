        tween(knob, {Position = state and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3)}, 0.2, Enum.EasingStyle.Back)
    end

    function obj.set(v)
        state = v and true or false
        render()
        pcall(callback, state)
    end

    function obj.get()
        return state
    end

    connect(click.Activated, function()
        obj.set(not state)
    end)

    if bindId then
        registerBind(bindId, defaultKey, function()
            obj.set(not state)
        end)
        makeBindButton(row, bindId, UDim2.new(1, -136, 0.5, -12))
    end

    render()
    return obj
end

local function addSlider(page, text, min, max, default, callback)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 56),
        BackgroundColor3 = THEME.item,
        BorderSizePixel = 0,
        LayoutOrder = nextOrder(),
    }, page)
    corner(row, 8)

    new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(14, 8),
        Size = UDim2.new(1, -100, 0, 18),
        Font = Enum.Font.GothamMedium,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = THEME.text,
        Text = text,
    }, row)

    local valueLabel = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -84, 0, 8),
        Size = UDim2.fromOffset(70, 18),
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextColor3 = THEME.accent2,
        Text = tostring(default),
    }, row)

    local bar = new("Frame", {
        Position = UDim2.new(0, 14, 0, 38),
        Size = UDim2.new(1, -28, 0, 6),
        BackgroundColor3 = THEME.off,
        BorderSizePixel = 0,
    }, row)
    corner(bar, 3)

    local fill = new("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, bar)
    corner(fill, 3)
    new("UIGradient", {Color = ColorSequence.new(THEME.accent, THEME.accent2)}, fill)

    local knob = new("Frame", {
        Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, bar)
    corner(knob, 7)

    local hit = new("TextButton", {
        Position = UDim2.fromOffset(0, -10),
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundTransparency = 1,
        Text = "",
    }, bar)

    local value = default

    local function render(v)
        local frac = (v - min) / (max - min)
        fill.Size = UDim2.new(frac, 0, 1, 0)
        knob.Position = UDim2.new(frac, -7, 0.5, -7)
        valueLabel.Text = tostring(v)
    end

    local dragging = false

    local function fromX(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
        local v = math.floor(min + (max - min) * rel + 0.5)
        if v ~= value then
            value = v
            render(v)
            pcall(callback, v)
        end
    end

    connect(hit.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            fromX(input.Position.X)
        end
    end)

    connect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            fromX(input.Position.X)
        end
    end)

    connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    render(default)

    return {
        set = function(v)
            value = v
            render(v)
        end,
    }
end

local function addButton(page, text, callback)
    local btn = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = THEME.item,
        AutoButtonColor = false,
        Text = text,
        Font = Enum.Font.GothamMedium,
        TextSize = 14,
        TextColor3 = THEME.text,
        LayoutOrder = nextOrder(),
    }, page)
    corner(btn, 8)

    connect(btn.MouseEnter, function()
        tween(btn, {BackgroundColor3 = THEME.hover}, 0.15)
    end)
    connect(btn.MouseLeave, function()
        tween(btn, {BackgroundColor3 = THEME.item}, 0.15)
    end)
    connect(btn.Activated, function()
        btn.BackgroundColor3 = THEME.accent
        tween(btn, {BackgroundColor3 = THEME.hover}, 0.3)
        pcall(callback)
    end)
end

