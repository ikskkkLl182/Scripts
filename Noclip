-- Mobile Noclip - polished UI (LocalScript)
-- All comments in English. No Russian text in code.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local noclipEnabled = false
local pulsing = false

-- ===== COLORS =====
local OFF_BG     = Color3.fromRGB(210, 60, 60)
local ON_BG      = Color3.fromRGB(55, 200, 105)
local OFF_STROKE = Color3.fromRGB(140, 25, 25)
local ON_STROKE  = Color3.fromRGB(30, 130, 70)
local RING_COLOR = Color3.fromRGB(90, 255, 140)

-- ===== GUI =====
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "NoclipGui"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.DisplayOrder = 999
screenGui.Parent = playerGui

-- Container (holds shadow, ring, button)
local container = Instance.new("Frame")
container.Name = "Container"
container.Size = UDim2.new(0, 84, 0, 84)
container.Position = UDim2.new(0, 22, 0.5, -42)
container.BackgroundTransparency = 1
container.Parent = screenGui

-- Drop shadow
local shadow = Instance.new("Frame")
shadow.Name = "Shadow"
shadow.Size = UDim2.new(1, 0, 1, 0)
shadow.Position = UDim2.new(0, 2, 0, 4)
shadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
shadow.BackgroundTransparency = 0.55
shadow.BorderSizePixel = 0
shadow.ZIndex = 1
shadow.Parent = container
local shadowCorner = Instance.new("UICorner")
shadowCorner.CornerRadius = UDim.new(0.32, 0)
shadowCorner.Parent = shadow

-- Pulse ring (expands outward when ON)
local ring = Instance.new("Frame")
ring.Name = "PulseRing"
ring.AnchorPoint = Vector2.new(0.5, 0.5)
ring.Position = UDim2.new(0.5, 0, 0.5, 0)
ring.Size = UDim2.new(1, 0, 1, 0)
ring.BackgroundTransparency = 1
ring.BorderSizePixel = 0
ring.ZIndex = 1
ring.Parent = container
local ringCorner = Instance.new("UICorner")
ringCorner.CornerRadius = UDim.new(0.32, 0)
ringCorner.Parent = ring
local ringStroke = Instance.new("UIStroke")
ringStroke.Color = RING_COLOR
ringStroke.Thickness = 3
ringStroke.Transparency = 1
ringStroke.Parent = ring

-- Main button
local button = Instance.new("TextButton")
button.Name = "NoclipButton"
button.AnchorPoint = Vector2.new(0.5, 0.5)
button.Position = UDim2.new(0.5, 0, 0.5, 0)
button.Size = UDim2.new(1, 0, 1, 0)
button.BackgroundColor3 = OFF_BG
button.BorderSizePixel = 0
button.AutoButtonColor = false
button.Text = "NOCLIP"
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.TextScaled = true
button.Font = Enum.Font.GothamBlack
button.ZIndex = 3
button.Parent = container

local buttonCorner = Instance.new("UICorner")
buttonCorner.CornerRadius = UDim.new(0.32, 0)
buttonCorner.Parent = button

local buttonStroke = Instance.new("UIStroke")
buttonStroke.Color = OFF_STROKE
buttonStroke.Thickness = 2
buttonStroke.Parent = button

-- Glossy top highlight
local gradient = Instance.new("UIGradient")
gradient.Rotation = 90
gradient.Transparency = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.55),
	NumberSequenceKeypoint.new(0.5, 1),
	NumberSequenceKeypoint.new(1, 1),
})
gradient.Parent = button

-- Text padding (keep text inside button, not on the edges)
button.TextSize = 20
local textPadding = Instance.new("UIPadding")
textPadding.PaddingTop = UDim.new(0.15, 0)
textPadding.PaddingBottom = UDim.new(0.15, 0)
textPadding.PaddingLeft = UDim.new(0.08, 0)
textPadding.PaddingRight = UDim.new(0.08, 0)
textPadding.Parent = button

-- ===== NOCLIP LOGIC =====
local function setNoclip(character, state)
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = not state
		end
	end
end

-- Pulse ring loop
local function pulseLoop()
	while pulsing do
		ring.Size = UDim2.new(1, 0, 1, 0)
		ringStroke.Transparency = 0.15

		local sizeTween = TweenService:Create(
			ring,
			TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Size = UDim2.new(1.7, 0, 1.7, 0) }
		)
		local strokeTween = TweenService:Create(
			ringStroke,
			TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Transparency = 1 }
		)
		sizeTween:Play()
		strokeTween:Play()
		task.wait(0.85)
	end
	ring.Size = UDim2.new(1, 0, 1, 0)
	ringStroke.Transparency = 1
end

-- Smooth color transition
local function animateColors(on)
	local bgTween = TweenService:Create(
		button,
		TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ BackgroundColor3 = on and ON_BG or OFF_BG }
	)
	local strokeTween = TweenService:Create(
		buttonStroke,
		TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Color = on and ON_STROKE or OFF_STROKE }
	)
	bgTween:Play()
	strokeTween:Play()
end

local function toggleNoclip()
	noclipEnabled = not noclipEnabled

	animateColors(noclipEnabled)

	if noclipEnabled then
		button.Text = "ON"
		if not pulsing then
			pulsing = true
			task.spawn(pulseLoop)
		end
	else
		button.Text = "NOCLIP"
		pulsing = false
	end

	if player.Character then
		setNoclip(player.Character, noclipEnabled)
	end
end

-- Press feedback (scale down on touch)
button.MouseButton1Down:Connect(function()
	TweenService:Create(
		button,
		TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = UDim2.new(0.92, 0, 0.92, 0) }
	):Play()
end)

button.MouseButton1Up:Connect(function()
	TweenService:Create(
		button,
		TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Size = UDim2.new(1, 0, 1, 0) }
	):Play()
end)

button.MouseButton1Click:Connect(toggleNoclip)

-- ===== KEEP COLLISIONS OFF =====
RunService.Stepped:Connect(function()
	if not noclipEnabled then return end
	local character = player.Character
	if not character then return end
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part.CanCollide then
			part.CanCollide = false
		end
	end
end)
