-- ===== SNOWFLAKES =====
local snowflakes = {}
local snowRunning = true

local function currentSnowColor()
	return noclipEnabled and ON_SNOW or OFF_SNOW
end

local function spawnSnowflake()
	local flake = Instance.new("TextLabel")
	flake.Name = "Flake"
	flake.AnchorPoint = Vector2.new(0.5, 0)
	flake.Size = UDim2.new(0, 12, 0, 12)
	flake.Position = UDim2.new(math.random(5, 95) / 100, 0, 0, -12)
	flake.BackgroundTransparency = 1
	flake.BorderSizePixel = 0
	flake.Text = "❄"
	flake.TextColor3 = currentSnowColor()
	flake.TextSize = math.random(9, 13)
	flake.Font = Enum.Font.GothamBold
	flake.TextTransparency = 0.15 + math.random() * 0.35
	flake.ZIndex = 3
	flake.Parent = background
	table.insert(snowflakes, flake)

	local duration = 1.0 + math.random() * 1.5
	local tween = TweenService:Create(flake, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Position = UDim2.new(flake.Position.X.Scale, 0, 0, 40)
	})
	tween:Play()
	tween.Completed:Connect(function()
		for i, f in ipairs(snowflakes) do
			if f == flake then
				table.remove(snowflakes, i)
				break
			end
		end
		flake:Destroy()
	end)
end

task.spawn(function()
	while snowRunning do
		spawnSnowflake()
		task.wait(0.28)
	end
end)

local function recolorSnow()
	local color = currentSnowColor()
	for _, f in ipairs(snowflakes) do
		TweenService:Create(f, TweenInfo.new(0.3), { TextColor3 = color }):Play()
	end
end

-- ===== NOCLIP LOGIC =====
local function setNoclip(character, state)
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = not state
		end
	end
end

local function toggleNoclip()
	noclipEnabled = not noclipEnabled

	TweenService:Create(background, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ BackgroundColor3 = noclipEnabled and ON_BG or OFF_BG }):Play()
	TweenService:Create(bgStroke, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Color = noclipEnabled and ON_STROKE or OFF_STROKE }):Play()

	textLabel.Text = noclipEnabled and "ON" or "NOCLIP"
	recolorSnow()

	if player.Character then
		setNoclip(player.Character, noclipEnabled)
	end
end

-- ===== DRAG & TAP =====
local dragging = false
local dragMoved = false
local dragStart
local startX, startY
local DRAG_THRESHOLD = 8

local function isTouchOrClick(input)
	return input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1
end

button.InputBegan:Connect(function(input)
	if not isTouchOrClick(input) then return end
	if dragging then return end
	dragging = true
	dragMoved = false
	dragStart = input.Position
	local absPos = container.AbsolutePosition
	local guiPos = screenGui.AbsolutePosition
	startX = absPos.X - guiPos.X
	startY = absPos.Y - guiPos.Y
	container.Position = UDim2.new(0, startX, 0, startY)
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then return end
	if not dragMoved then
		local delta = input.Position - dragStart
		if (delta.X * delta.X + delta.Y * delta.Y) > (DRAG_THRESHOLD * DRAG_THRESHOLD) then
			dragMoved = true
		end
	end
	if dragMoved and (input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseMovement) then
		local delta = input.Position - dragStart
		local vp = workspace.CurrentCamera.ViewportSize
		local maxX = math.max(0, vp.X - container.AbsoluteSize.X)
		local maxY = math.max(0, vp.Y - container.AbsoluteSize.Y)
		local newX = math.clamp(startX + delta.X, 0, maxX)
		local newY = math.clamp(startY + delta.Y, 0, maxY)
		container.Position = UDim2.new(0, newX, 0, newY)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if not dragging then return end
	if not isTouchOrClick(input) then return end
	if not dragMoved then
		toggleNoclip()
	end
	dragging = false
	dragMoved = false
end)

-- ===== KEEP COLLISIONS OFF =====
RunService.Stepped:Connect(function()
	if not noclipEnabled then return end
	local character = player.Character
	if not character then return end
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part.CanCollide then
			part.CanCollide = false
		end
	end
end)
