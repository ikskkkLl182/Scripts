connect(RunService.Stepped, function()
    local char = player.Character
    if S.noclip and char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                if noclipOriginal[part] == nil then
                    noclipOriginal[part] = part.CanCollide
                end
                part.CanCollide = false
            end
        end
    end
end)
 
connect(RunService.Heartbeat, function()
    local hum = getHum()
    local root = getRoot()
 
    if hum then
        if S.speed then
            hum.WalkSpeed = S.speedVal
        end
        if S.jump then
            hum.UseJumpPower = true
            hum.JumpPower = S.jumpVal
        end
    end
 
    if S.fly and hum and root then
        if not flyBV or flyBV.Parent ~= root then
            stopFly()
            flyBV = new("BodyVelocity", {
                MaxForce = Vector3.new(1e9, 1e9, 1e9),
                Velocity = Vector3.zero,
            }, root)
            flyBG = new("BodyGyro", {
                MaxTorque = Vector3.new(1e9, 1e9, 1e9),
                P = 9e4,
            }, root)
        end
 
        local up = 0
        if not UserInputService:GetFocusedTextBox() then
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then up = up + 1 end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then up = up - 1 end
        end
 
        flyBV.Velocity = hum.MoveDirection * S.flySpeed + Vector3.new(0, up * S.flySpeed, 0)
 
        local cam = workspace.CurrentCamera
        if cam then
            local look = cam.CFrame.LookVector
            local flat = Vector3.new(look.X, 0, look.Z)
            if flat.Magnitude > 0.01 then
                flyBG.CFrame = CFrame.new(root.Position, root.Position + flat)
            end
        end
    end
end)
 
connect(RunService.RenderStepped, function()
    strokeGrad.Rotation = (os.clock() * 80) % 360
    if S.fov then
        local cam = workspace.CurrentCamera
        if cam then cam.FieldOfView = S.fov end
    end
end)
 
env.__AstralCleanup = function()
    S.noclip = false
    S.fly = false
    restoreNoclip()
    stopFly()
 
    local hum = getHum()
    if hum then
        if S.speed then hum.WalkSpeed = defaults.walk end
        if S.jump then
            hum.UseJumpPower = defaults.useJumpPower
            hum.JumpPower = defaults.jump
        end
    end
    S.speed = false
    S.jump = false
 
    setFullbright(false)
    workspace.Gravity = defaultGravity
 
    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    gui:Destroy()
    env.__AstralCleanup = nil
end
 
