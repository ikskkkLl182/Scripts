-- ===== FLYING DOTS =====
local dots = {}
local dotsRunning = true

local function currentDotColor()
	return noclipEnabled and ON_COLOR or OFF_COLOR
end

local function spawnDot()
	local dot = Instance.new("Frame")
	dot.Name = "Dot"
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	local size = math.random(3, 5)
	dot.Size = UDim2.new(0, size, 0, size)
	dot.BackgroundColor3 = currentDotColor()
	dot.BackgroundTransparency = 0.25 + math.random() * 0.35
	dot.BorderSizePixel = 0
	dot.ZIndex = 3
	dot.Parent = background

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = dot

	local goingDown = math.random() > 0.5
	local startY = goingDown and -0.15 or 1.15
	local endY   = goingDown and 1.15  or -0.15
	local xScale = math.random(6, 94) / 100

	dot.Position = UDim2.new(xScale, 0, startY, 0)
	table.insert(dots, dot)

	local duration = 0.9 + math.random() * 1.4
	local tween = TweenService:Create(dot, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Position = UDim2.new(xScale, 0, endY, 0)
	})
	tween:Play()
	tween.Completed:Connect(function()
		for i, d in ipairs(dots) do
			if d == dot then
				table.remove(dots, i)
				break
			end
		end
		dot:Destroy()
	end)
end

task.spawn(function()
	while dotsRunning do
		spawnDot()
		task.wait(0.22)
	end
end)

local function recolorDots()
	local color = currentDotColor()
	for _, d in ipairs(dots) do
		TweenService:Create(d, TweenInfo.new(0.25), { BackgroundColor3 = color }):Play()
	end
end

-- ===== NOCLIP LOGIC =====
local function setNoclip(character, state)
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = not state
		end
	end
end

local function toggleNoclip()
	noclipEnabled = not noclipEnabled

	local color = currentDotColor()
	TweenService:Create(textLabel, TweenInfo.new(0.25), { TextColor3 = color }):Play()
	textLabel.Text = noclipEnabled and "ON" or "NOCLIP"
	recolorDots()

	if player.Character then
		setNoclip(player.Character, noclipEnabled)
	end
end

-- ===== DRAG & TAP =====
local dragging = false
local dragMoved = false
local dragStart
local startX, startY
local DRAG_THRESHOLD = 8

local function isTouchOrClick(input)
	return input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1
end

button.InputBegan:Connect(function(input)
	if not isTouchOrClick(input) then return end
	if dragging then return end
	dragging = true
	dragMoved = false
	dragStart = input.Position
	local absPos = container.AbsolutePosition
	local guiPos = screenGui.AbsolutePosition
	startX = absPos.X - guiPos.X
	startY = absPos.Y - guiPos.Y
	container.Position = UDim2.new(0, startX, 0, startY)
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then return end
	if not dragMoved then
		local delta = input.Position - dragStart
		if (delta.X * delta.X + delta.Y * delta.Y) > (DRAG_THRESHOLD * DRAG_THRESHOLD) then
			dragMoved = true
		end
	end
	if dragMoved and (input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseMovement) then
		local delta = input.Position - dragStart
		local vp = workspace.CurrentCamera.ViewportSize
		local maxX = math.max(0, vp.X - container.AbsoluteSize.X)
		local maxY = math.max(0, vp.Y - container.AbsoluteSize.Y)
		local newX = math.clamp(startX + delta.X, 0, maxX)
		local newY = math.clamp(startY + delta.Y, 0, maxY)
		container.Position = UDim2.new(0, newX, 0, newY)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if not dragging then return end
	if not isTouchOrClick(input) then return end
	if not dragMoved then
		toggleNoclip()
	end
	dragging = false
	dragMoved = false
end)

-- ===== KEEP COLLISIONS OFF =====
RunService.Stepped:Connect(function()
	if not noclipEnabled then return end
	local character = player.Character
	if not character then return end
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part.CanCollide then
			part.CanCollide = false
		end
	end
end)
