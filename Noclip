local function toggle(name,key)
    local b=Instance.new("TextButton")
    b.Size=UDim2.new(1,-8,0,42); b.BackgroundColor3=Color3.fromRGB(35,35,45)
    b.TextColor3=Color3.new(1,1,1); b.Font=Enum.Font.Gotham; b.TextSize=14
    b.Text=name..": OFF"; b.Parent=scroll
    Instance.new("UICorner",b).CornerRadius=UDim.new(0,8)
    b.MouseButton1Click:Connect(function()
        CFG[key]=not CFG[key]
        b.Text=name..": "..(CFG[key] and "ON" or "OFF")
        b.BackgroundColor3=CFG[key] and Color3.fromRGB(60,160,80) or Color3.fromRGB(35,35,45)
    end)
end
local function slider(name,key,min,max)
    local f=Instance.new("Frame")
    f.Size=UDim2.new(1,-8,0,58); f.BackgroundColor3=Color3.fromRGB(35,35,45)
    f.Parent=scroll; Instance.new("UICorner",f).CornerRadius=UDim.new(0,8)
    local l=Instance.new("TextLabel")
    l.Size=UDim2.new(1,-12,0,24); l.Position=UDim2.new(0,6,0,2)
    l.BackgroundTransparency=1; l.Text=name..": "..CFG[key]
    l.TextColor3=Color3.new(1,1,1); l.Font=Enum.Font.Gotham; l.TextSize=13
    l.TextXAlignment=Enum.TextXAlignment.Left; l.Parent=f
    local box=Instance.new("TextBox")
    box.Size=UDim2.new(1,-12,0,26); box.Position=UDim2.new(0,6,0,28)
    box.BackgroundColor3=Color3.fromRGB(25,25,32); box.TextColor3=Color3.new(1,1,1)
    box.PlaceholderText=tostring(CFG[key]); box.Text=""
    box.Font=Enum.Font.Gotham; box.TextSize=13; box.Parent=f
    Instance.new("UICorner",box).CornerRadius=UDim.new(0,6)
    box.FocusLost:Connect(function()
        local n=tonumber(box.Text)
        if n and n>=min and n<=max then
            CFG[key]=n; l.Text=name..": "..n
        end
        box.Text=""
    end)
end

