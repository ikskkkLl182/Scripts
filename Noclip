button.Size = UDim2.new(1, 0, 1, 0)
button.BackgroundColor3 = OFF_BG
button.BorderSizePixel = 0
button.AutoButtonColor = false
button.Text = "NOCLIP"
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.TextSize = 12
button.Font = Enum.Font.GothamBold
button.ZIndex = 3
button.Parent = container

local buttonCorner = Instance.new("UICorner")
buttonCorner.CornerRadius = UDim.new(0, 8)
buttonCorner.Parent = button

local buttonStroke = Instance.new("UIStroke")
buttonStroke.Color = OFF_STROKE
buttonStroke.Thickness = 1.5
buttonStroke.Parent = button

local gradient = Instance.new("UIGradient")
gradient.Rotation = 90
gradient.Transparency = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.55),
	NumberSequenceKeypoint.new(0.5, 1),
	NumberSequenceKeypoint.new(1, 1),
})
gradient.Parent = button

-- ===== NOCLIP LOGIC =====
local function setNoclip(character, state)
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = not state
		end
	end
end

local function pulseLoop()
	while pulsing do
		ring.Size = UDim2.new(1, 0, 1, 0)
		ringStroke.Transparency = 0.15
		TweenService:Create(ring, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(1.7, 0, 1.7, 0)
		}):Play()
		TweenService:Create(ringStroke, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Transparency = 1
		}):Play()
		task.wait(0.85)
	end
	ring.Size = UDim2.new(1, 0, 1, 0)
	ringStroke.Transparency = 1
end

local function animateColors(on)
	TweenService:Create(button, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ BackgroundColor3 = on and ON_BG or OFF_BG }):Play()
	TweenService:Create(buttonStroke, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Color = on and ON_STROKE or OFF_STROKE }):Play()
end

local function toggleNoclip()
	noclipEnabled = not noclipEnabled
	animateColors(noclipEnabled)
	if noclipEnabled then
		button.Text = "ON"
		if not pulsing then
			pulsing = true
			task.spawn(pulseLoop)
		end
	else
		button.Text = "NOCLIP"
		pulsing = false
	end
	if player.Character then
		setNoclip(player.Character, noclipEnabled)
	end
end

-- ===== DRAG & TAP =====
local dragging = false
local dragMoved = false
local dragStart
local startX, startY
local DRAG_THRESHOLD = 8

local function isTouchOrClick(input)
	return input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1
end

button.InputBegan:Connect(function(input)
	if not isTouchOrClick(input) then return end
	if dragging then return end
	dragging = true
	dragMoved = false
	dragStart = input.Position
	local absPos = container.AbsolutePosition
	local guiPos = screenGui.AbsolutePosition
	startX = absPos.X - guiPos.X
	startY = absPos.Y - guiPos.Y
	container.Position = UDim2.new(0, startX, 0, startY)
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then return end
	if not dragMoved then
		local delta = input.Position - dragStart
		if (delta.X * delta.X + delta.Y * delta.Y) > (DRAG_THRESHOLD * DRAG_THRESHOLD) then
			dragMoved = true
		end
	end
	if dragMoved and (input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseMovement) then
		local delta = input.Position - dragStart
		local vp = workspace.CurrentCamera.ViewportSize
		local maxX = math.max(0, vp.X - container.AbsoluteSize.X)
		local maxY = math.max(0, vp.Y - container.AbsoluteSize.Y)
		local newX = math.clamp(startX + delta.X, 0, maxX)
		local newY = math.clamp(startY + delta.Y, 0, maxY)
		container.Position = UDim2.new(0, newX, 0, newY)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if not dragging then return end
	if not isTouchOrClick(input) then return end
	if not dragMoved then
		toggleNoclip()
	end
	dragging = false
	dragMoved = false
end)

-- ===== KEEP COLLISIONS OFF =====
RunService.Stepped:Connect(function()
	if not noclipEnabled then return end
	local character = player.Character
	if not character then return end
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part.CanCollide then
			part.CanCollide = false
		end
	end
end)
