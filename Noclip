local function GetGameValue(obj,name)
    if not obj then return nil end
    local a=obj:GetAttribute(name); if a~=nil then return a end
    local c=obj:FindFirstChild(name)
    if c then local s,v=pcall(function() return c.Value end); if s then return v end end
    return nil
end
local function ApplyHighlight(obj,color)
    if not obj then return end
    local h=obj:FindFirstChild("H") or Instance.new("Highlight")
    h.Name="H"; h.Adornee=obj; h.FillColor=color; h.OutlineColor=color
    h.FillTransparency=0.8; h.OutlineTransparency=0.3
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; h.Parent=obj
end
local function RemoveHighlight(obj)
    if not obj then return end
    local h=obj:FindFirstChild("H"); if h then h:Destroy() end
end
local function CreateBillboardTag(text,color,size,textSize)
    local b=Instance.new("BillboardGui"); b.Name="BitchHook"; b.AlwaysOnTop=true
    b.Size=size or UDim2.new(0,120,0,30)
    local l=Instance.new("TextLabel")
    l.Name="BitchHook"; l.Size=UDim2.new(1,0,1,0); l.BackgroundTransparency=1
    l.Text=text; l.TextColor3=color; l.TextStrokeTransparency=0
    l.TextStrokeColor3=Color3.new(0,0,0); l.Font=Enum.Font.GothamBold
    l.TextSize=textSize or 10; l.TextWrapped=true; l.RichText=true; l.Parent=b
    return b
end
local function cleanupPlayerESP(player)
    if not player.Character then return end
    local root=player.Character:FindFirstChild("HumanoidRootPart")
    if root then
        for _,n in ipairs({"BitchHook","MaskHook"}) do
            local o=root:FindFirstChild(n); if o then o:Destroy() end
        end
    end
    RemoveHighlight(player.Character)
    for _,n in ipairs({player.Name.."_Chased",player.Name.."_Killer"}) do
        local o=IndicatorGui:FindFirstChild(n); if o then o:Destroy() end
    end
end

local function updatePlayerNametag(player)
    if not player.Character then cleanupPlayerESP(player); return end
    local rootPart=player.Character:FindFirstChild("HumanoidRootPart")
    local humanoid=player.Character:FindFirstChildOfClass("Humanoid")
    if not rootPart then return end
    local teamName=(player.Team and player.Team.Name:lower()) or ""
    local isKiller=teamName:find("killer")~=nil
    local selectedKiller=GetGameValue(player,"SelectedKiller")
    local rawMask=GetGameValue(player,"Mask") or GetGameValue(player.Character,"Mask")
    local isKnocked=GetGameValue(player.Character,"Knocked")
    local isHooked=GetGameValue(player.Character,"IsHooked")
    local isChased=GetGameValue(player.Character,"IsChased")
    local color=isKiller and PlayerColors.Killer or PlayerColors.Survivor
    if isHooked then color=Color3.fromRGB(255,182,193)
    elseif humanoid and humanoid.Health<humanoid.MaxHealth then
        color=isKnocked and Color3.fromRGB(200,100,0) or Color3.fromRGB(200,200,0)
    end
    local distance=0
    if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        distance=math.floor((rootPart.Position-LP.Character.HumanoidRootPart.Position).Magnitude)
    end
    local baseName=(isKiller and selectedKiller and tostring(selectedKiller)~="")
        and tostring(selectedKiller) or player.Name
    local billboard=rootPart:FindFirstChild("BitchHook")
    local nameText=baseName.."\n["..distance.." studs]"
    if not billboard then
        billboard=CreateBillboardTag(nameText,color); billboard.Adornee=rootPart; billboard.Parent=rootPart
    else
        local lbl=billboard:FindFirstChild("BitchHook") or billboard:FindFirstChildOfClass("TextLabel")
        if lbl then lbl.Text=nameText; lbl.TextColor3=color end
    end
    ApplyHighlight(player.Character,color)
    local hasMask=false
    if isKiller and string.match(tostring(selectedKiller):lower(),"masked") and rawMask then
        local sm=tostring(rawMask):lower()
        for key,name in pairs(MaskNames) do
            if key:lower()==sm then
                hasMask=true
                local mb=rootPart:FindFirstChild("MaskHook")
                if not mb then
                    mb=CreateBillboardTag(name,MaskColors[key] or Color3.new(1,1,1),UDim2.new(0,100,0,20),12)
                    mb.Name="MaskHook"; mb.StudsOffset=Vector3.new(0,3,0)
                    mb.Adornee=rootPart; mb.Parent=rootPart
                else
                    local lbl=mb:FindFirstChild("BitchHook") or mb:FindFirstChildOfClass("TextLabel")
                    if lbl then lbl.Text=name; lbl.TextColor3=MaskColors[key] or Color3.new(1,1,1) end
                end
                break
            end
        end
    end
    if not hasMask then
        local mb=rootPart:FindFirstChild("MaskHook"); if mb then mb:Destroy() end
    end
    local chased2D=IndicatorGui:FindFirstChild(player.Name.."_Chased")
    if isChased then
        if not chased2D then
            chased2D=Instance.new("TextLabel",IndicatorGui)
            chased2D.Name=player.Name.."_Chased"; chased2D.BackgroundTransparency=1
            chased2D.Font=Enum.Font.GothamBold; chased2D.TextSize=24
            chased2D.TextStrokeTransparency=0; chased2D.AnchorPoint=Vector2.new(0.5,0.5)
        end
        chased2D.Text,chased2D.TextColor3="!!",color
        local sp,onS=Camera:WorldToScreenPoint(rootPart.Position)
        if onS then chased2D.Visible=false
        else
            chased2D.Visible=true
            local c=Camera.ViewportSize/2
            local d=Vector2.new(sp.X,sp.Y)-c
            if sp.Z<0 then d=-d end
            local sc=math.max(math.abs(d.X)/(c.X-30),math.abs(d.Y)/(c.Y-30))
            chased2D.Position=UDim2.new(0,c.X+d.X/(sc==0 and 1 or sc),0,c.Y+d.Y/(sc==0 and 1 or sc))
        end
    elseif chased2D then chased2D:Destroy() end
    local killer2D=IndicatorGui:FindFirstChild(player.Name.."_Killer")
    if isKiller then
        if not killer2D then
            killer2D=Instance.new("TextLabel",IndicatorGui)
            killer2D.Name=player.Name.."_Killer"; killer2D.BackgroundTransparency=1
            killer2D.Font=Enum.Font.GothamBold; killer2D.TextSize=11
            killer2D.TextStrokeTransparency=0
            killer2D.Size=UDim2.new(0,120,0,30); killer2D.RichText=true
            killer2D.AnchorPoint=Vector2.new(0.5,0.5)
        end
        killer2D.Text=baseName.."\n["..distance.." studs]"
        killer2D.TextColor3=color
        local sp,onS=Camera:WorldToScreenPoint(rootPart.Position)
        if not onS then
            killer2D.Visible=true
            local c=Camera.ViewportSize/2
            local d=Vector2.new(sp.X,sp.Y)-c
            if sp.Z<0 then d=-d end
            local sc=math.max(math.abs(d.X)/(c.X-30),math.abs(d.Y)/(c.Y-30))
            killer2D.Position=UDim2.new(0,c.X+d.X/(sc==0 and 1 or sc),0,c.Y+d.Y/(sc==0 and 1 or sc))
        else killer2D.Visible=false end
    elseif killer2D then killer2D:Destroy() end
end

local function updateGeneratorProgress(gen)
    if not gen or not gen.Parent then return true end
    local pct=GetGameValue(gen,"RepairProgress") or GetGameValue(gen,"Progress") or 0
    local bb=gen:FindFirstChild("GenBitchHook")
    if pct>=100 then
        if bb then bb:Destroy() end; RemoveHighlight(gen); return true
    end
    local cp=math.clamp(pct,0,100)
    local finalColor=cp<50 and ObjectColors.Generator:Lerp(Color3.fromRGB(180,180,0),cp/50)
        or Color3.fromRGB(180,180,0):Lerp(Color3.fromRGB(0,150,0),(cp-50)/50)
    local str=string.format("[%.2f%%]",pct)
    if not bb then
        bb=CreateBillboardTag(str,finalColor); bb.Name="GenBitchHook"
        bb.StudsOffset=Vector3.new(0,2,0)
        bb.Adornee=gen:FindFirstChild("defaultMaterial",true) or gen; bb.Parent=gen
    else
        local lbl=bb:FindFirstChild("BitchHook") or bb:FindFirstChildOfClass("TextLabel")
        if lbl then lbl.Text=str; lbl.TextColor3=finalColor end
    end
    return false
end

local function RefreshESP()
    ActiveGenerators={}
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj.Name=="Window" then
            if Cfg.espWindows then ApplyHighlight(obj,ObjectColors.Window)
            else RemoveHighlight(obj) end
        end
    end
    local Map=workspace:FindFirstChild("Map"); if not Map then return end
    for _,obj in ipairs(Map:GetDescendants()) do
        if obj.Name=="Generator" then
            if Cfg.espGenerators then
                ApplyHighlight(obj,ObjectColors.Generator); table.insert(ActiveGenerators,obj)
            else
                RemoveHighlight(obj)
                local bb=obj:FindFirstChild("GenBitchHook"); if bb then bb:Destroy() end
            end
        elseif obj.Name=="Hook" then
            local m=obj:FindFirstChild("Model")
            if m then for _,p in ipairs(m:GetDescendants()) do
                if p:IsA("MeshPart") then
                    if Cfg.espHooks then ApplyHighlight(p,ObjectColors.Hook)
                    else RemoveHighlight(p) end
                end
            end end
        elseif obj.Name=="Palletwrong" or obj.Name=="Pallet" then
            if Cfg.espPallets then ApplyHighlight(obj,ObjectColors.Pallet)
            else RemoveHighlight(obj) end
        elseif obj.Name=="Gate" then
            if Cfg.espGates then ApplyHighlight(obj,ObjectColors.Gate)
            else RemoveHighlight(obj) end
        end
    end
end

