-- ===== FLY (logic from Fly GUI V3) =====
local speeds = 1
local nowe = false
local tpwalking = false

local flyToggle
local flySlider

local flyCtrl = {f = 0, b = 0, l = 0, r = 0}
local flyLast = {f = 0, b = 0, l = 0, r = 0}
local flyMax = 50
local flySpeedNow = 0
local flyBodies = nil

-- your tpwalking block, unchanged
local function startTpWalk()
	tpwalking = false
	for i = 1, speeds do
		spawn(function()

			local hb = game:GetService("RunService").Heartbeat	


			tpwalking = true
			local chr = game.Players.LocalPlayer.Character
			local hum = chr and chr:FindFirstChildWhichIsA("Humanoid")
			while tpwalking and hb:Wait() and chr and hum and hum.Parent do
				if hum.MoveDirection.Magnitude > 0 then
					chr:TranslateBy(hum.MoveDirection)
				end
			end

		end)
	end
end

-- "plus" handler
local function flySpeedUp()
	if speeds >= 50 then return end
	speeds = speeds + 1
	if flySlider then flySlider.set(speeds) end
	if nowe == true then
		startTpWalk()
	end
end

-- "minus" handler (your code; the speed.Text lines are replaced by the slider)
local function flySpeedDown()
	if speeds == 1 then
		-- speed.Text = 'cannot be less than 1'
	else
		speeds = speeds - 1
		if flySlider then flySlider.set(speeds) end
		if nowe == true then
			startTpWalk()
		end
	end
end

-- "onof" handler: turn fly on
local function flyOn()
	local chr = player.Character
	local hum = chr and chr:FindFirstChildOfClass("Humanoid")
	local torso = chr and (chr:FindFirstChild("UpperTorso") or chr:FindFirstChild("Torso") or chr:FindFirstChild("HumanoidRootPart"))
	if not (chr and hum and torso) then return false end

	nowe = true
	startTpWalk()

	local animate = chr:FindFirstChild("Animate")
	if animate then animate.Disabled = true end
	for _, v in ipairs(hum:GetPlayingAnimationTracks()) do
		v:AdjustSpeed(0)
	end
	for _, v in ipairs(Enum.HumanoidStateType:GetEnumItems()) do
		pcall(function() hum:SetStateEnabled(v, false) end)
	end
	hum:ChangeState(Enum.HumanoidStateType.Swimming)

	local bg = Instance.new("BodyGyro")
	bg.P = 9e4
	bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	bg.CFrame = torso.CFrame
	bg.Parent = torso

	local bv = Instance.new("BodyVelocity")
	bv.Velocity = Vector3.new(0, 0.1, 0)
	bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	bv.Parent = torso

	hum.PlatformStand = true

	flyCtrl = {f = 0, b = 0, l = 0, r = 0}
	flyLast = {f = 0, b = 0, l = 0, r = 0}
	flySpeedNow = 0
	flyBodies = {bg = bg, bv = bv, hum = hum, chr = chr}
	return true
end

-- "onof" handler: turn fly off
local function flyOff()
	nowe = false
	tpwalking = false

	local b = flyBodies
	flyBodies = nil
	if not b then return end

	pcall(function() b.bg:Destroy() end)
	pcall(function() b.bv:Destroy() end)

	local hum = b.hum
	if hum and hum.Parent then
		pcall(function() hum.PlatformStand = false end)
		pcall(function()
			local animate = b.chr and b.chr:FindFirstChild("Animate")
			if animate then animate.Disabled = false end
		end)
		pcall(function()
			for _, v in ipairs(hum:GetPlayingAnimationTracks()) do
				v:AdjustSpeed(1)
			end
		end)
		pcall(function()
			for _, v in ipairs(Enum.HumanoidStateType:GetEnumItems()) do
				pcall(function() hum:SetStateEnabled(v, true) end)
			end
		end)
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.RunningNoPhysics) end)
	end
end

-- flight loop (BodyGyro / BodyVelocity, same formulas as Fly GUI V3)
connect(RunService.RenderStepped, function(dt)
	if not nowe then return end

	local b = flyBodies
	local cam = workspace.CurrentCamera
	if not (b and cam and b.chr == player.Character and b.hum.Parent and b.hum.Health > 0 and b.bv.Parent and b.bg.Parent) then
		if flyToggle then flyToggle.set(false) else flyOff() end
		return
	end

	local typing = UserInputService:GetFocusedTextBox() ~= nil
	local function down(k) return (not typing) and UserInputService:IsKeyDown(k) end

	flyCtrl.f = down(Enum.KeyCode.W) and 1 or 0
	flyCtrl.b = down(Enum.KeyCode.S) and -1 or 0
	flyCtrl.l = down(Enum.KeyCode.A) and -1 or 0
	flyCtrl.r = down(Enum.KeyCode.D) and 1 or 0

	-- up / down (Space / LeftShift), like the up/down buttons: CFrame.new(0, +-1, 0)
	local root = b.chr:FindFirstChild("HumanoidRootPart")
	if root then
		local step = math.min(dt * 60, 3)
		if down(Enum.KeyCode.Space) then
			root.CFrame = root.CFrame * CFrame.new(0, step, 0)
		end
		if down(Enum.KeyCode.LeftShift) then
			root.CFrame = root.CFrame * CFrame.new(0, -step, 0)
		end
	end

	local ctrl, lastctrl = flyCtrl, flyLast
	local bv, bg = b.bv, b.bg
	local camCF = cam.CFrame

	if ctrl.l + ctrl.r ~= 0 or ctrl.f + ctrl.b ~= 0 then
		flySpeedNow = flySpeedNow + .5 + (flySpeedNow / flyMax)
		if flySpeedNow > flyMax then
			flySpeedNow = flyMax
		end
	elseif not (ctrl.l + ctrl.r ~= 0 or ctrl.f + ctrl.b ~= 0) and flySpeedNow ~= 0 then
		flySpeedNow = flySpeedNow - 1
		if flySpeedNow < 0 then
			flySpeedNow = 0
		end
	end

	if (ctrl.l + ctrl.r) ~= 0 or (ctrl.f + ctrl.b) ~= 0 then
		bv.Velocity = ((camCF.LookVector * (ctrl.f + ctrl.b)) + ((camCF * CFrame.new(ctrl.l + ctrl.r, (ctrl.f + ctrl.b) * .2, 0).p) - camCF.p)) * flySpeedNow
		flyLast = {f = ctrl.f, b = ctrl.b, l = ctrl.l, r = ctrl.r}
	elseif (ctrl.l + ctrl.r) == 0 and (ctrl.f + ctrl.b) == 0 and flySpeedNow ~= 0 then
		bv.Velocity = ((camCF.LookVector * (lastctrl.f + lastctrl.b)) + ((camCF * CFrame.new(lastctrl.l + lastctrl.r, (lastctrl.f + lastctrl.b) * .2, 0).p) - camCF.p)) * flySpeedNow
	else
		bv.Velocity = Vector3.new(0, 0, 0)
	end

	bg.CFrame = camCF * CFrame.Angles(-math.rad((ctrl.f + ctrl.b) * 50 * flySpeedNow / flyMax), 0, 0)
end)

local lightSaved
local function setFullbright(on)
    if on then
        if lightSaved then return end
        lightSaved = {
            Brightness = Lighting.Brightness,
            ClockTime = Lighting.ClockTime,
            FogEnd = Lighting.FogEnd,
            GlobalShadows = Lighting.GlobalShadows,
            Ambient = Lighting.Ambient,
            OutdoorAmbient = Lighting.OutdoorAmbient,
        }
        pcall(function()
            Lighting.Brightness = 2
            Lighting.ClockTime = 14
            Lighting.FogEnd = 100000
            Lighting.GlobalShadows = false
            Lighting.Ambient = Color3.fromRGB(190, 190, 190)
            Lighting.OutdoorAmbient = Color3.fromRGB(190, 190, 190)
        end)
    elseif lightSaved then
        for k, v in pairs(lightSaved) do
            pcall(function() Lighting[k] = v end)
        end
        lightSaved = nil
    end
end

