local function selectTab(name)
    for n, t in pairs(tabs) do
        local active = n == name
        t.page.Visible = active
        tween(t.button, {BackgroundTransparency = active and 0 or 1}, 0.2)
        tween(t.label, {TextColor3 = active and THEME.text or THEME.dim}, 0.2)
        tween(t.bar, {BackgroundTransparency = active and 0 or 1}, 0.2)
    end
end
 
