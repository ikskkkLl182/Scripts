local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

local noclipActive = false
local connection = nil

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "AstralNoclipGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = CoreGui

local ActionButton = Instance.new("TextButton")
ActionButton.Size = UDim2.new(0, 120, 0, 45)
ActionButton.Position = UDim2.new(0.1, 0, 0.5, 0)
ActionButton.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
ActionButton.TextColor3 = Color3.fromRGB(255, 50, 50)
ActionButton.Text = "Noclip: OFF"
ActionButton.Font = Enum.Font.Code
ActionButton.TextSize = 14
ActionButton.BorderSizePixel = 0
ActionButton.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = ActionButton

local dragging, dragInput, dragStart, startPos

local function update(input)
    local delta = input.Position - dragStart
    local targetPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    TweenService:Create(ActionButton, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = targetPos}):Play()
end

ActionButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = ActionButton.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

ActionButton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

RunService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        update(input)
    end
end)

local function toggleNoclip()
    noclipActive = not noclipActive
    
    if noclipActive then
        ActionButton.TextColor3 = Color3.fromRGB(50, 255, 50)
        ActionButton.Text = "Noclip: ON"
        
        connection = RunService.Stepped:Connect(function()
            Character = LocalPlayer.Character
            if Character then
                for _, part in ipairs(Character:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        ActionButton.TextColor3 = Color3.fromRGB(255, 50, 50)
        ActionButton.Text = "Noclip: OFF"
        
        if connection then
            connection:Disconnect()
            connection = nil
        end
    end
end

ActionButton.MouseButton1Click:Connect(toggleNoclip)

LocalPlayer.CharacterAdded:Connect(function(newChar)
    Character = newChar
end)
