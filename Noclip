-- QTE Auto-Tester (executor LocalScript)
-- For testing your own game's QTE mechanic only.
-- All logs prefixed with [QTE-DEBUG]

local Players             = game:GetService("Players")
local RunService          = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Cleanup old instance
for _, old in ipairs(playerGui:GetChildren()) do
    if old.Name == "QTE_TesterGUI" then old:Destroy() end
end

-- =====================================================
-- CONFIG
-- =====================================================
local GUI_KEYWORDS     = {"Skill", "QTE", "Check", "Minigame"}
local POINTER_NAMES    = {"Pointer", "Arrow", "Indicator", "Needle", "Line"}
local ZONE_NAMES       = {"Zone", "Target", "GreenZone", "Bar"}
local FALLBACK_MIN     = 120
local FALLBACK_MAX     = 160
local GUI_SCAN_INTERVAL = 0.15
local KEY_HOLD_TIME    = 0.03

-- =====================================================
-- STATE
-- =====================================================
local enabled        = false
local currentGui     = nil
local currentPointer = nil
local currentZone    = nil
local lastGuiScan    = 0
local insideZone     = false

-- =====================================================
-- TOGGLE BUTTON
-- =====================================================
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "QTE_TesterGUI"
