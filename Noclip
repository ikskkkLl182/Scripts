local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

local noclipActive = false
local noclipConnection = nil

local TargetParent = nil
local success, err = pcall(function()
    if gethud then return gethud() end
    if get_hidden_gui then return get_hidden_gui() end
    return LocalPlayer:WaitForChild("PlayerGui")
end)
TargetParent = success and err or LocalPlayer:WaitForChild("PlayerGui")

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "AstralEngine_Noclip"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = TargetParent

local ActionButton = Instance.new("TextButton")
ActionButton.Size = UDim2.new(0, 140, 0, 50)
ActionButton.Position = UDim2.new(0.5, -70, 0.5, -25)
ActionButton.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
ActionButton.TextColor3 = Color3.fromRGB(255, 75, 75)
ActionButton.Text = "Noclip: OFF"
ActionButton.Font = Enum.Font.Code
ActionButton.TextSize = 15
ActionButton.BorderSizePixel = 0
ActionButton.Active = true
ActionButton.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 6)
UICorner.Parent = ActionButton

local UIStroke = Instance.new("UIStroke")
UIStroke.Thickness = 1.5
UIStroke.Color = Color3.fromRGB(40, 40, 40)
UIStroke.Parent = ActionButton

local dragging = false
local dragInput = nil
local dragStart = nil
local startPos = nil

local function updatePosition(input)
    local delta = input.Position - dragStart
    local targetPos = UDim2.new(
        startPos.X.Scale, 
        startPos.X.Offset + delta.X, 
        startPos.Y.Scale, 
        startPos.Y.Offset + delta.Y
    )
    TweenService:Create(ActionButton, TweenInfo.new(0.08, Enum.EasingStyle.OutQuad), {Position = targetPos}):Play()
end

ActionButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = ActionButton.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

ActionButton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        updatePosition(input)
    end
end)

local function forceNoclip()
    if Character then
        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end

local function toggleNoclip()
    noclipActive = not noclipActive
    
    if noclipActive then
        ActionButton.TextColor3 = Color3.fromRGB(75, 255, 75)
        UIStroke.Color = Color3.fromRGB(75, 255, 75)
        ActionButton.Text = "Noclip: ON"
        
        noclipConnection = RunService.Heartbeat:Connect(forceNoclip)
    else
        ActionButton.TextColor3 = Color3.fromRGB(255, 75, 75)
        UIStroke.Color = Color3.fromRGB(40, 40, 40)
        ActionButton.Text = "Noclip: OFF"
        
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end

ActionButton.MouseButton1Click:Connect(toggleNoclip)

LocalPlayer.CharacterAdded:Connect(function(newChar)
    Character = newChar
end)
