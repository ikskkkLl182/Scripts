-- Mobile Noclip - compact draggable rectangle button (v2)
-- Auto-cleans old GUIs on start.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ===== CLEAN OLD GUIS =====
for _, old in ipairs(playerGui:GetChildren()) do
	if old.Name == "NoclipGui" then
		old:Destroy()
	end
end

local noclipEnabled = false
local pulsing = false

-- ===== COLORS =====
local OFF_BG     = Color3.fromRGB(210, 60, 60)
local ON_BG      = Color3.fromRGB(55, 200, 105)
local OFF_STROKE = Color3.fromRGB(140, 25, 25)
local ON_STROKE  = Color3.fromRGB(30, 130, 70)
local RING_COLOR = Color3.fromRGB(90, 255, 140)

-- ===== GUI =====
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "NoclipGui"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.DisplayOrder = 999
screenGui.Parent = playerGui

local container = Instance.new("Frame")
container.Name = "Container"
container.Size = UDim2.new(0, 60, 0, 34)
container.Position = UDim2.new(0, 20, 0.5, -17)
container.BackgroundTransparency = 1
container.Parent = screenGui

local shadow = Instance.new("Frame")
shadow.Name = "Shadow"
shadow.Size = UDim2.new(1, 0, 1, 0)
shadow.Position = UDim2.new(0, 2, 0, 2)
shadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
shadow.BackgroundTransparency = 0.55
shadow.BorderSizePixel = 0
shadow.ZIndex = 1
shadow.Parent = container
local shadowCorner = Instance.new("UICorner")
shadowCorner.CornerRadius = UDim.new(0, 8)
shadowCorner.Parent = shadow

local ring = Instance.new("Frame")
ring.Name = "PulseRing"
ring.AnchorPoint = Vector2.new(0.5, 0.5)
ring.Position = UDim2.new(0.5, 0, 0.5, 0)
ring.Size = UDim2.new(1, 0, 1, 0)
ring.BackgroundTransparency = 1
ring.BorderSizePixel = 0
ring.ZIndex = 1
ring.Parent = container
local ringCorner = Instance.new("UICorner")
ringCorner.CornerRadius = UDim.new(0, 8)
ringCorner.Parent = ring
local ringStroke = Instance.new("UIStroke")
ringStroke.Color = RING_COLOR
ringStroke.Thickness = 2
ringStroke.Transparency = 1
ringStroke.Parent = ring

local button = Instance.new("TextButton")
