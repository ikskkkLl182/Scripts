        render()
        pcall(callback, state)
    end
 
    function obj.get()
        return state
    end
 
    connect(click.Activated, function()
        obj.set(not state)
    end)
 
    render()
    return obj
end
 
local function addSlider(page, text, min, max, default, callback)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 56),
        BackgroundColor3 = THEME.item,
        BorderSizePixel = 0,
        LayoutOrder = nextOrder(),
